---
interface Props { number: string; title: string; intro?: string; }
const { number, title, intro } = Astro.props;
---
<header class="section-head" data-reveal>
  <span class="eyebrow">{number}</span>
  <div>
    <h2 class="section-title">{title}</h2>
    {intro && <p class="lead">{intro}</p>}
  </div>
</header>
